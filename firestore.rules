rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - email: string (required)
    //   - role: string (required, ['admin', 'editor', 'user'])
    //   - name: string (optional)
    //
    // Collection: categories
    // Fields:
    //   - name: string (required)
    //   - slug: string (required)
    //   - description: string
    //   - image: string
    //
    // Collection: products
    // Fields:
    //   - name: string (required)
    //   - slug: string (required)
    //   - categoryId: string (required)
    //   - description: string
    //   - features: list
    //   - specs: map
    //   - images: list
    //   - downloads: list of maps
    //
    // Collection: blogPosts
    // Fields:
    //   - title: string (required)
    //   - slug: string (required)
    //   - content: string (required)
    //   - date: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.email == "devcloudpy@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isEditor() {
      return isAuthenticated() && 
        ((request.auth.token.email == "devcloudpy@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor']));
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && !('role' in request.resource.data));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
